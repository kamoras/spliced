{
  "name": "spliced",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A daily music puzzle: reassemble a shuffled song clip from its spliced pieces.",
  "license": "MIT",
  "author": "Ryan Mack",
  "homepage": "https://github.com/kamoras/spliced#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamoras/spliced.git"
  },
  "bugs": {
    "url": "https://github.com/kamoras/spliced/issues"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:catalog": "tsx scripts/build-catalog.ts",
    "enrich:catalog": "tsx scripts/catalog-meta.ts",
    "build:art": "node scripts/og/render.cjs",
    "beats:catalog": "tsx scripts/beats.ts",
    "curate:catalog": "tsx scripts/curate-catalog.ts",
    "schedule": "tsx scripts/schedule.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.10"
  }
}
